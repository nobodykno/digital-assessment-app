

VITE_API_URL=http://localhost:5001/v1/api
VITE_APP_NAME=Digital Asset Management
VITE_APP_ENV=development



NODE_ENV=
PORT=5001




DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=your_postgres_password

# Database connection pool
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Database retry
DB_RETRY_MAX=3




JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=24h




UPLOAD_PATH=uploads




LOG_LEVEL=info




CORS_ORIGIN=http://localhost:5173,http://localhost:5001




RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10




BCRYPT_SALT_ROUNDS=10



MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

MINIO_BUCKET=assets

MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key


#Docker 

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=dam
RABBITMQ_QUEUE=file-processing



POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=dam_api



RABBITMQ_DEFAULT_USER=your_rabbitmq_username
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=dam
RABBITMQ_MANAGEMENT_PORT=15672




MINIO_ROOT_USER=your_minio_access_key
MINIO_ROOT_PASSWORD=your_minio_secret_key
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001