{
  "name": "@dam/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:undo": "tsx src/scripts/migrate-undo.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:undo": "tsx scripts/seed-undo.ts",
    "migrate:test": "NODE_ENV=test tsx src/scripts/migrate.ts",
    "migrate:test:undo": "NODE_ENV=test tsx src/scripts/migrate-undo.ts",
    "seed:test": "NODE_ENV=test tsx src/scripts/seed.ts",
    "seed:test:undo": " NODE_ENV=test tsx src/scripts/seed-undo.ts",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/logs/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./repositories": {
      "types": "./dist/repositories/index.d.ts",
      "import": "./dist/repositories/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    }
  },
  "dependencies": {
    "@dam/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "bcryptjs": "^3.0.3",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  }
}
